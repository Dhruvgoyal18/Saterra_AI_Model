# Copy to .env for local overrides. HF_TOKEN and HF_DATASET_REPO are
# required in every environment, including local dev -- the dataset repo is
# private, and there is no local-file fallback anymore (see
# steps_of_implementation_checkpoint2.md for why this changed).

HF_TOKEN=
HF_DATASET_REPO=Dhruvgoyal18/saterra-project

# Supabase Auth (invite-only) -- required in every environment. Every
# /images, /images/{id}/display, and /detect request must carry a valid
# Supabase session token (see main.py's require_user), verified here against
# the same project the frontend signs users into. Project URL + anon key
# from Supabase dashboard -> Settings -> API. The anon key is safe to put
# here even though this is otherwise a "secrets" file -- it's meant to be
# public (same value goes in frontend/.env as VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Groq (Checkpoint 3) -- required for POST /chat's function-calling.
# console.groq.com -> API Keys -> Create API Key. Backend-only, same
# reasoning as HF_TOKEN: never sent to the frontend.
GROQ_API_KEY=

# Where generated display PNGs (+ a small dims sidecar per image) are
# cached locally, relative to backend/ if a relative path. Safe to delete
# any time -- everything in it is regenerated on demand from HF.
HF_DISPLAY_CACHE_DIR=.cache/display

# Comma-separated list of allowed frontend origins, or "*" for a demo
CORS_ORIGINS=*
