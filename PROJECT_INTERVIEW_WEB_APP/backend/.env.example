# Copy to .env for local overrides. All of these have working defaults for
# local dev (STORAGE_BACKEND=local) already baked into app/config.py.

# "local" (read bucket_staging/ + sibling DAPI_images/) or "hf" (private HF dataset repo)
STORAGE_BACKEND=local

# Only needed when STORAGE_BACKEND=hf
HF_TOKEN=
HF_DATASET_REPO=

# Comma-separated list of allowed frontend origins, or "*" for a demo
CORS_ORIGINS=*
